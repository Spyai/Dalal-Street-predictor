# =============================================================================
# Dalal: environment configuration
# Copy to .env (`cp .env.example .env`) and fill in. .env is gitignored.
# Never paste these values into chats, issues, or commits.
# SETUP.md walks through obtaining every key below.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Signs login sessions and encrypts the daily Kite access token at rest.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Host interface Docker publishes the web UI/API on.
#   127.0.0.1      -> laptop only (default)
#   100.x.y.z      -> your machine's Tailscale IP, reachable from your phone on the tailnet
# Never use 0.0.0.0 on a VPS: that makes the app public.
BIND_ADDR=127.0.0.1
WEB_PORT=3000

# The URL you open in the browser. Used in Telegram links and the Kite redirect.
# Examples: http://127.0.0.1:3000  |  http://dalal-box.tailnet-name.ts.net:3000
APP_BASE_URL=http://127.0.0.1:3000

# true only if you serve over HTTPS (e.g. `tailscale serve` / `tailscale cert`).
COOKIE_SECURE=false

# Login session lifetime in hours.
SESSION_TTL_HOURS=168

# One-time web setup of your login at APP_BASE_URL/setup?token=<SETUP_TOKEN>.
# Needed on Vercel (no terminal). Min 16 chars; leave empty to disable. Setup only works
# while no login exists, so it cannot be reused once you've created yours.
SETUP_TOKEN=

# debug | info | warning | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (TimescaleDB) and Redis: defaults work with docker compose
# -----------------------------------------------------------------------------
POSTGRES_USER=dalal
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=dalal
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional full override; if set, the POSTGRES_* values above are ignored by the app.
# DATABASE_URL=postgresql+psycopg://dalal:password@db:5432/dalal

REDIS_URL=redis://redis:6379/0
# On Vercel, the Neon and Upstash integrations set POSTGRES_URL/DATABASE_URL and KV_URL;
# Dalal reads those automatically.

# -----------------------------------------------------------------------------
# 1. Broker: Zerodha Kite Connect (REQUIRED for live quotes / intraday / holdings)
# -----------------------------------------------------------------------------
# From https://developers.kite.trade -> My apps -> your app.
KITE_API_KEY=
KITE_API_SECRET=
# Optional: your Zerodha client ID (e.g. AB1234). If set, Dalal rejects a login
# from any other Zerodha account.
KITE_USER_ID=
# The redirect URL registered in the Kite developer console MUST be:
#   ${APP_BASE_URL}/api/kite/callback
# Kite access tokens expire every day at ~06:00 IST. Dalal sends you a Telegram
# login link at KITE_LOGIN_REMINDER_TIME if no valid token exists for the day.
KITE_LOGIN_REMINDER_TIME=07:00

# Which provider serves market data. Only "kite" is implemented for live data;
# yfinance is always the EOD-history fallback.
BROKER=kite

# -----------------------------------------------------------------------------
# 2. Anthropic (REQUIRED from Phase 2: news sentiment, briefs, post-mortems)
# -----------------------------------------------------------------------------
# From https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Long-form writing (daily brief, post-mortems, weekly report).
ANTHROPIC_MODEL_WRITER=claude-opus-5-5
# High-volume, short tasks (per-headline sentiment, dedup summaries).
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# -----------------------------------------------------------------------------
# Market call (Phase 2). Defaults are fine; every value is tunable.
# -----------------------------------------------------------------------------
# Which INDEX symbols get a daily call.
PREDICTION_TARGETS=NIFTY 50,NIFTY BANK
# |close-to-close %| beyond this is UP/DOWN, otherwise FLAT.
MARKET_FLAT_THRESHOLD_PCT=0.30
# |open vs previous close %| beyond this counts as a gap.
GAP_THRESHOLD_PCT=0.25
# Top-two class probabilities closer than this = "No edge today".
NO_EDGE_MARGIN=0.08
# Calls written after this IST time are flagged late in the ledger.
LEDGER_LOCK_TIME=09:15
# Graded calls needed before the "unproven model" warning goes away.
MIN_SAMPLE_SIZE=100
# Walk-forward: first fold size and refit cadence (trading sessions).
WF_MIN_TRAIN_DAYS=500
WF_STEP_DAYS=21
# A challenger must beat the champion's out-of-sample Brier score by this much.
RETRAIN_MIN_BRIER_GAIN=0.005
# Optional MLflow tracking server; empty keeps the registry in Postgres only.
MLFLOW_TRACKING_URI=

# -----------------------------------------------------------------------------
# 3. Telegram (REQUIRED: alerts + morning brief, private chat only)
# -----------------------------------------------------------------------------
# From @BotFather -> /newbot.
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (see SETUP.md). Dalal only ever messages this chat.
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# 4. FRED (OPTIONAL: US macro series and calendar)
# -----------------------------------------------------------------------------
# From https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# -----------------------------------------------------------------------------
# 5. NewsAPI or similar (OPTIONAL: news fallback when RSS is thin)
# -----------------------------------------------------------------------------
NEWSAPI_KEY=

# -----------------------------------------------------------------------------
# Public data sources (NSE/BSE archives, yfinance)
# -----------------------------------------------------------------------------
# Dalal identifies itself honestly. If NSE blocks this user agent, the source is
# marked "unavailable" in the UI; Dalal does not rotate identities to get around it.
NSE_USER_AGENT=Dalal/0.1 (+personal research tool; single user; <=1 req/s)
# Minimum seconds between requests to the same public host.
PUBLIC_SOURCE_MIN_INTERVAL_SECONDS=1.0
# Seconds before a request to a public source times out.
PUBLIC_SOURCE_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Universe and backfill
# -----------------------------------------------------------------------------
# nifty500 | nifty200 | nifty100 | nifty50 | watchlist
UNIVERSE=nifty500
# Comma-separated NSE symbols always included, e.g. RELIANCE,HDFCBANK,TATAMOTORS
WATCHLIST=
# Years of daily history the backfill loads.
BACKFILL_YEARS=5
# Exclude stocks below this 20-day average turnover (INR crore). Phase 3.
MIN_AVG_TURNOVER_CR=10

# -----------------------------------------------------------------------------
# Jobs
# -----------------------------------------------------------------------------
# internal = the scheduler container runs jobs (Docker Compose).
# external = GitHub Actions runs them (Vercel deployment, see DEPLOY_VERCEL.md).
SCHEDULER_MODE=internal
# Attempts per scheduled job before it is marked failed and you get a Telegram alert.
JOB_MAX_ATTEMPTS=3
# First retry delay in seconds; doubles each attempt (30s, 60s, 120s ...).
JOB_BACKOFF_SECONDS=30
# Minutes between global-cue refreshes.
GLOBAL_CUES_REFRESH_MINUTES=10

# -----------------------------------------------------------------------------
# Prediction and risk settings (used from Phase 2/3, editable later in Settings)
# -----------------------------------------------------------------------------
# Nifty close-to-close move (%) beyond which the day is UP/DOWN, else FLAT.
MARKET_FLAT_THRESHOLD_PCT=0.30
# Paper trading capital (INR).
PAPER_CAPITAL=1000000
# Risk per paper trade as % of paper capital.
RISK_PER_TRADE_PCT=1.0
# Graded predictions needed before the "unproven model" warning disappears.
MIN_SAMPLE_SIZE=100
